# Local development. Copy to .env -- .env is git-ignored.
# No Entra registration, no SQL Server, no SharePoint needed to run locally.

ACC_ENV=development
ACC_SECRET_KEY=local-dev-only-not-a-real-secret

# SQLite file under instance/. Created automatically by: flask dev-init
ACC_DATABASE_URI=sqlite+pysqlite:///instance/atkore_compliance_dev.db

# Stub sign-in -- no password, no Entra tenant required
ACC_AUTH_PROVIDER=dev
ACC_DEV_UPN=vpandey@atkore.com
ACC_DEV_DISPLAY_NAME=Vikash Pandey

# Never send mail from a laptop
ACC_REMINDER_DRY_RUN=true
ACC_ENABLE_SCHEDULER=false

ACC_LOG_DIR=logs
ACC_LOG_LEVEL=DEBUG
