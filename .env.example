# ---- Environment ----
ACC_ENV=production
ACC_SECRET_KEY=<random-64-char-string>

# ---- SQL Server ----
ACC_DATABASE_URI=mssql+pyodbc://@ATKSQL01/AtkoreCompliance?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ---- Microsoft Entra ID ----
ACC_AUTH_PROVIDER=entra
ACC_ENTRA_TENANT_ID=<tenant-guid>
ACC_ENTRA_CLIENT_ID=<app-registration-client-id>
ACC_ENTRA_CLIENT_SECRET=<client-secret-or-cert-thumbprint>
ACC_ENTRA_REDIRECT_PATH=/auth/callback
ACC_ENTRA_POST_LOGOUT_URI=https://compliance.atkore.com/

# ---- SharePoint Online attachment storage (Microsoft Graph) ----
ACC_SPO_HOSTNAME=atkore.sharepoint.com
ACC_SPO_SITE_PATH=/sites/Compliance
ACC_SPO_SITE_ID=
ACC_SPO_DRIVE_ID=
ACC_SPO_ATTACHMENT_ROOT=ComplianceEvidence
ACC_SPO_REFERENCE_ROOT=ReferenceDocuments

# ---- Business rules ----
ACC_GROUP1_THRESHOLD=250000
ACC_GROUP2_THRESHOLD=450000

# ---- Jobs ----
ACC_ENABLE_SCHEDULER=true
ACC_REMINDER_CRON=0 13 * * *
ACC_MAIL_SENDER_UPN=compliance-noreply@atkore.com
ACC_REMINDER_DRY_RUN=false

# ---- Logging ----
ACC_LOG_DIR=D:\logs\atkore_compliance
ACC_LOG_LEVEL=INFO
