{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: run local (SQLite + dev auth)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["run", "--port", "5000", "--debug"],
      "jinja": true,
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "FLASK_APP": "run.py",
        "ACC_ENV": "development"
      }
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "justMyCode": false,
      "env": { "ACC_ENV": "testing" }
    }
  ]
}
